#!/bin/sh
# Builds (first run only) and starts the OpenRocket MCP server over stdio.
# Used by .mcp.json for Claude Code, and usable directly from Claude Desktop.
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/build/install/openrocket-mcp/bin/openrocket-mcp"
if ! command -v java >/dev/null 2>&1 && [ -z "$JAVA_HOME" ]; then
  echo "openrocket-mcp: Java 17 or newer is required (https://adoptium.net)." >&2
  exit 1
fi
if [ ! -x "$BIN" ] || [ -n "$(find "$ROOT/src" "$ROOT/build.gradle" -newer "$BIN" 2>/dev/null | head -1)" ]; then
  echo "openrocket-mcp: building (first run can take a minute)..." >&2
  (cd "$ROOT" && ./gradlew -q installDist >&2)
fi
exec "$BIN" "$@"
